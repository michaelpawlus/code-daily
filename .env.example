# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=your_token_here

# Your GitHub username
GITHUB_USERNAME=your_username_here

# Anthropic API Key (optional - enables AI-powered quest enhancement)
# Create one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_api_key_here

# Notification settings (optional - enables Duolingo-style commit reminders)
# Sign up at https://ntfy.sh for free push notifications
NTFY_TOPIC=          # unique topic string, e.g. "code-daily-abc123"
NTFY_SERVER=         # defaults to https://ntfy.sh
